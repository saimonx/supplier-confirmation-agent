# Copy to .env and fill in. None of these are needed to run the tests.

# OpenAI key used to classify hotel replies, draft answers and search for a
# replacement hotel email.
OPENAI_API_KEY=

# Sender shown to hotels on confirmation emails.
SUPPLIER_EMAIL_FROM_NAME=
SUPPLIER_EMAIL_FROM_ADDRESS=

# Address copied on the automatic customer emails. Defaults to ops@example.com.
AGENT_COPY_EMAIL=

# Optional. Comma-separated task types the agent must leave to a person.
AGENT_DISABLED_TASK_TYPES=
